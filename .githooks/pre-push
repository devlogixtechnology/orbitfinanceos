#!/bin/sh
set -eu

while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/staging)
      echo "Direct pushes to ${remote_ref#refs/heads/} are blocked. Push a topic branch and use a pull request." >&2
      exit 1
      ;;
  esac
done

node scripts/check-public-boundary.mjs --tracked
