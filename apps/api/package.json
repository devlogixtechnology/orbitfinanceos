{
  "name": "@orbitos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src test --max-warnings=0",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@orbitos/authz": "workspace:*",
    "@orbitos/canonical-model": "workspace:*",
    "@orbitos/connector-bsc": "workspace:*",
    "@orbitos/database": "workspace:*",
    "@orbitos/evidence-core": "workspace:*",
    "@orbitos/ingestion-core": "workspace:*",
    "@orbitos/integration-core": "workspace:*",
    "@orbitos/reconciliation-core": "workspace:*",
    "@orbitos/verification-core": "workspace:*",
    "fastify": "catalog:"
  }
}
